# Model — OpenRouter. Deliberately not Claude/GPT.
OPENROUTER_API_KEY=
MODEL=moonshotai/kimi-k2.5
FALLBACK_MODEL=deepseek/deepseek-v3.2

# Surfaces
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Public URL of the deployed web chat (used for OpenRouter attribution + link hints)
PUBLIC_URL=

# Walrus Memory: omit to use ~/.memwal/credentials.json (local dev).
# Set these two on the server, where there is no credentials file.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz

# Web search (optional). Brave's free tier covers 2,000 queries a month.
# Without it /search falls back to encyclopedia entries and says so.
BRAVE_API_KEY=

# Screenshots need a browser. Usually found automatically; set this when it
# lives somewhere unusual.
CHROME_PATH=

# Where the Discord button on the landing page points.
DISCORD_INVITE_URL=
DISCORD_CLIENT_ID=
